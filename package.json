{
    "name": "secret-terminal",
    "private": true,
    "scripts": {
        "dev": "concurrently \"turbo dev\" \"sleep 2 && open http://localhost:3000\"",
        "build": "turbo run build --filter=apps/frontend...",
        "build:backend": "turbo run build --filter=apps/backend...",
        "start": "turbo start",
        "lint": "turbo lint"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "turbo": "latest",
        "wait-on": "^9.1.0"
    },
    "packageManager": "pnpm@11.24.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.24.0"
        }
    }
}